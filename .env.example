# Optional. Public endpoints are used when these are unset — fine to start,
# worth replacing once your board gets traffic.
RPC_ETHEREUM=
RPC_BASE=

# Set this to switch on /admin. Without it the admin refuses to load at all.
ADMIN_PASSWORD=

# Optional: signs the admin session cookie. Derived from the password if unset.
ADMIN_SECRET=

# Needed only so a DEPLOYED admin can save. A deployed filesystem is read-only,
# so saves are committed back to the repo instead. Fine-grained token with
# Contents: read and write, scoped to this repository.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# Optional: lets an approved collab open a raffle in Discord.
# COLLAB_BOT_URL is your bot's endpoint; COLLAB_BOT_SECRET must be the same
# value as COLLAB_WEBHOOK_SECRET on the bot. Unset means the admin still
# approves partners, it just cannot post anything.
COLLAB_BOT_URL=
COLLAB_BOT_SECRET=

# Sign in to /admin with X or Google instead of a shared password.
# Set the pair for whichever you want; a provider with no client ID simply
# does not appear on the sign-in page.
#   X:      developer.x.com -> an OAuth 2.0 app, Confidential client
#   Google: console.cloud.google.com -> Credentials -> OAuth client ID (Web)
# Callback URL to register, for each:
#   https://YOUR-DOMAIN/api/auth/x/callback
#   https://YOUR-DOMAIN/api/auth/google/callback
OAUTH_X_CLIENT_ID=
OAUTH_X_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Who may edit. X handles and Google emails, comma separated.
# AN EMPTY LIST ADMITS NOBODY — a missing value must not open the admin.
ADMIN_ALLOWLIST=
