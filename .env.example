# Optional. Public endpoints are used when these are unset — fine to start,
# worth replacing once your board gets traffic.
RPC_ETHEREUM=
RPC_BASE=

# Set this to switch on /admin. Without it the admin refuses to load at all.
ADMIN_PASSWORD=

# Optional: signs the admin session cookie. Derived from the password if unset.
ADMIN_SECRET=

# Needed only so a DEPLOYED admin can save. A deployed filesystem is read-only,
# so saves are committed back to the repo instead. Fine-grained token with
# Contents: read and write, scoped to this repository.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# Optional: lets an approved collab open a raffle in Discord.
# COLLAB_BOT_URL is your bot's endpoint; COLLAB_BOT_SECRET must be the same
# value as COLLAB_WEBHOOK_SECRET on the bot. Unset means the admin still
# approves partners, it just cannot post anything.
COLLAB_BOT_URL=
COLLAB_BOT_SECRET=
